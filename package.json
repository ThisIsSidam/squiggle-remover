{
  "name": "squiggle-remover",
  "version": "0.1.0",
  "description": "Removes spellcheck squiggles from underscored, capitalized and bold text in chosen folders.",
  "author": "Anshu Kumar Singh",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^26.6.6",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
